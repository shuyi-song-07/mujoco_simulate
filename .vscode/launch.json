{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Paper A · Collection",
      "type": "debugpy",
      "request": "launch",
      "module": "collection",
      "python": "/home/dex/miniconda3/envs/mujoco/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "start",
        "--task",
        "${input:task}"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONNOUSERSITE": "1",
        "PYTHONPATH": ""
      }
    },
    {
      "name": "Paper A · Baseline 20000 steps",
      "type": "debugpy",
      "request": "launch",
      "module": "training.papera",
      "python": "D:/Conda/envs/paperA_train/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--task",
        "${input:task}",
        "--variant",
        "baseline",
        "--pack",
        "${input:pack}"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONNOUSERSITE": "1",
        "PYTHONPATH": ""
      }
    },
    {
      "name": "Paper A · Gesture 20000 steps",
      "type": "debugpy",
      "request": "launch",
      "module": "training.papera",
      "python": "D:/Conda/envs/paperA_train/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--task",
        "${input:task}",
        "--variant",
        "gesture",
        "--pack",
        "${input:pack}"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONNOUSERSITE": "1",
        "PYTHONPATH": ""
      }
    },
    {
      "name": "Paper A · Resume interrupted run",
      "type": "debugpy",
      "request": "launch",
      "module": "training.papera",
      "python": "D:/Conda/envs/paperA_train/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--task",
        "${input:task}",
        "--resume",
        "${input:last}"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONNOUSERSITE": "1",
        "PYTHONPATH": ""
      }
    },
    {
      "name": "Paper A · Rollout check",
      "type": "debugpy",
      "request": "launch",
      "module": "rollout",
      "python": "D:/Conda/envs/paperA_train/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--task",
        "${input:task}",
        "--mode",
        "check",
        "--run",
        "${input:run}"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONNOUSERSITE": "1",
        "PYTHONPATH": ""
      }
    },
    {
      "name": "Paper A · Rollout preview 60 s",
      "type": "debugpy",
      "request": "launch",
      "module": "rollout",
      "python": "D:/Conda/envs/paperA_train/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--task",
        "${input:task}",
        "--mode",
        "preview",
        "--run",
        "${input:run}",
        "--seed",
        "910001",
        "--max-seconds",
        "60"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONNOUSERSITE": "1",
        "PYTHONPATH": ""
      }
    }
  ],
  "inputs": [
    {
      "id": "task",
      "type": "promptString",
      "description": "Registered task_id (python -m collection list)",
      "default": "tray_transfer"
    },
    {
      "id": "pack",
      "type": "promptString",
      "description": "Verified Training Pack absolute path; same Pack for both variants"
    },
    {
      "id": "last",
      "type": "promptString",
      "description": "Exact checkpoints/last.pt path; keeps frozen original budget"
    },
    {
      "id": "run",
      "type": "promptString",
      "description": "Training run directory containing run.json (not a .pt file)"
    }
  ]
}
