{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ACT 训练",
      "type": "debugpy",
      "request": "launch",
      "module": "training.papera",
      "python": "D:/Conda/envs/paperA_train/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--task",
        "${input:task}",
        "--variant",
        "baseline",
        "--pack",
        "${input:pack}"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONNOUSERSITE": "1",
        "PYTHONPATH": ""
      }
    },
    {
      "name": "DP 训练",
      "type": "debugpy",
      "request": "launch",
      "module": "training.diffusion",
      "python": "D:/Conda/envs/paperA_train/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--task",
        "${input:task}",
        "--variant",
        "baseline",
        "--pack",
        "${input:pack}"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONNOUSERSITE": "1",
        "PYTHONPATH": ""
      }
    },
    {
      "name": "ACT + 手势辅助监督训练",
      "type": "debugpy",
      "request": "launch",
      "module": "training.papera",
      "python": "D:/Conda/envs/paperA_train/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--task",
        "${input:task}",
        "--variant",
        "gesture",
        "--pack",
        "${input:pack}"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONNOUSERSITE": "1",
        "PYTHONPATH": ""
      }
    },
    {
      "name": "DP + 手势辅助监督训练（待实现）",
      "type": "debugpy",
      "request": "launch",
      "module": "training.diffusion",
      "python": "D:/Conda/envs/paperA_train/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--task",
        "${input:task}",
        "--variant",
        "gesture",
        "--pack",
        "${input:pack}"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONNOUSERSITE": "1",
        "PYTHONPATH": ""
      }
    }
  ],
  "inputs": [
    {
      "id": "task",
      "type": "promptString",
      "description": "Registered task_id (python -m collection list)",
      "default": "tray_transfer"
    },
    {
      "id": "pack",
      "type": "promptString",
      "description": "Formal Training Pack absolute path; share Pack/split for ACT and DP comparisons"
    }
  ]
}
