<mujoco model="panda Push-T scene">
  <include file="panda.xml"/>

  <option timestep="0.001"
          integrator="implicitfast"
          iterations="50"
          noslip_iterations="5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7"
             rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <body name="overview_camera_target" pos="0.45 0 0.55"/>
    <camera name="overview_camera" mode="targetbody"
            target="overview_camera_target" pos="1.55 -1.65 1.35" fovy="48"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <body name="table" pos="0.5 0 0.2">
      <geom type="box" size="0.4 0.5 0.2"
            friction="0.45 0.01 0.001"
            solref="0.004 1" solimp="0.95 0.99 0.001"
            rgba="0.55 0.35 0.2 1"/>
    </body>

    <!-- One 0.1 kg rigid T made from two non-overlapping collision boxes. -->
    <body name="cube" pos="0.5 0 0.415">
      <freejoint/>
      <!-- 100x30 mm top bar; mass is proportional to its share of T area. -->
      <geom name="push_t_bar" type="box" pos="0.035 0 0"
            size="0.015 0.050 0.015" mass="0.0588235294"
            friction="0.45 0.01 0.001"
            solref="0.004 1" solimp="0.95 0.99 0.001"
            rgba="1 0 0 1"/>
      <!-- 70x30 mm stem, joined exactly to the inner edge of the bar. -->
      <geom name="push_t_stem" type="box" pos="-0.015 0 0"
            size="0.035 0.015 0.015" mass="0.0411764706"
            friction="0.45 0.01 0.001"
            solref="0.004 1" solimp="0.95 0.99 0.001"
            rgba="1 0 0 1"/>
    </body>

    <!-- Visual-only 1.10x T goal. It has no collision and cannot block pushes. -->
    <body name="target_plate" pos="0.60 -0.16 0.401">
      <geom name="push_t_goal_bar" type="box" pos="0.035 0 0"
            size="0.020 0.055 0.001"
            contype="0" conaffinity="0" rgba="1 1 1 0.72"/>
      <geom name="push_t_goal_stem" type="box" pos="-0.015 0 0"
            size="0.040 0.020 0.001"
            contype="0" conaffinity="0" rgba="1 1 1 0.72"/>
    </body>
  </worldbody>
</mujoco>
