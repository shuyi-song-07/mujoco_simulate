<mujoco model="panda push scene">
  <include file="panda.xml"/>

  <option timestep="0.001"
          integrator="implicitfast"
          iterations="80"
          noslip_iterations="10"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6"
               ambient="0.3 0.3 0.3"
               specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox"
             builtin="gradient"
             rgb1="0.3 0.5 0.7"
             rgb2="0 0 0"
             width="512"
             height="3072"/>

    <texture type="2d"
             name="groundplane"
             builtin="checker"
             mark="edge"
             rgb1="0.2 0.3 0.4"
             rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8"
             width="300"
             height="300"/>

    <material name="groundplane"
              texture="groundplane"
              texuniform="true"
              texrepeat="5 5"
              reflectance="0.2"/>
  </asset>

  <worldbody>

    <light pos="0 0 1.5"
           dir="0 0 -1"
           directional="true"/>

    <!-- 固定第三视角：覆盖 Panda、整张桌子、方块和目标圆盘。 -->
    <body name="overview_camera_target" pos="0.45 0 0.55"/>
    <camera name="overview_camera"
            mode="targetbody"
            target="overview_camera_target"
            pos="1.55 -1.65 1.35"
            fovy="48"/>

    <!-- 地面 -->
    <geom name="floor"
          size="0 0 0.05"
          type="plane"
          material="groundplane"/>

    <!-- 桌子 -->
    <body name="table" pos="0.5 0 0.2">
      <geom name="table_surface" type="box"
            size="0.4 0.5 0.2"
            friction="2 0.1 0.02"
            condim="4"
            solref="0.002 1"
            solimp="0.99 0.999 0.0002 0.5 2"
            rgba="0.55 0.35 0.2 1"/>
    </body>

    <!-- 红色方块 -->
    <body name="cube" pos="0.5 0 0.43">
      <freejoint/>

      <geom type="box"
      size="0.030 0.030 0.030"
      mass="0.1"
      friction="6 0.18 0.03"
      condim="4"
      solref="0.002 1"
      solimp="0.99 0.999 0.0002 0.5 2"
      rgba="1 0 0 1"/>
    </body>

    <body name="distractor_blue" pos="0.42 0.18 0.427">
      <freejoint/>
      <geom name="distractor_blue_geom" type="box" size="0.025 0.025 0.025" mass="0.08" friction="4 0.12 0.02" condim="4" solref="0.002 1" solimp="0.99 0.999 0.0002 0.5 2" rgba="0.08 0.32 0.95 1"/>
    </body>
    <body name="distractor_green" pos="0.58 0.18 0.437">
      <freejoint/>
      <geom name="distractor_green_geom" type="box" size="0.035 0.035 0.035" mass="0.12" friction="4 0.12 0.02" condim="4" solref="0.002 1" solimp="0.99 0.999 0.0002 0.5 2" rgba="0.08 0.78 0.2 1"/>
    </body>
    <body name="distractor_yellow" pos="0.42 -0.18 0.422">
      <freejoint/>
      <geom name="distractor_yellow_geom" type="box" size="0.02 0.02 0.02" mass="0.06" friction="4 0.12 0.02" condim="4" solref="0.002 1" solimp="0.99 0.999 0.0002 0.5 2" rgba="0.98 0.8 0.08 1"/>
    </body>

    <!-- 白色放置目标：方块进入圆盘范围后自动解除 Z 锁定 -->
    <body name="target_plate" pos="0.60 -0.16 0.408">
      <geom name="target_plate_geom"
            type="cylinder"
            size="0.09 0.008"
            friction="2 0.1 0.02"
            condim="4"
            solref="0.002 1"
            solimp="0.99 0.999 0.0002 0.5 2"
            rgba="1 1 1 1"/>
    </body>

  </worldbody>
</mujoco>
